services:
<% if (database === 'postgresql') { %>
  postgres:
    image: postgres:16-alpine
    container_name: <%= projectName %>-postgres
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: app
    ports:
      - "5433:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d app"]
      interval: 5s
      timeout: 5s
      retries: 5

<% } %>
  api:
    build:
      context: .
      dockerfile: apps/api/Dockerfile
    container_name: <%= projectName %>-api
    environment:
      DATABASE_URL: <%= dockerDatabaseUrl %>
      JWT_SECRET: <%= jwtSecret %>
      PORT: 3001
      FRONTEND_URL: ${FRONTEND_URL:-http://localhost:3002}
    ports:
      - "3001:3001"
<% if (database === 'postgresql') { %>
    depends_on:
      postgres:
        condition: service_healthy
<% } %>
    command: >
      sh -c "pnpm --filter ./apps/api run db:deploy && pnpm --filter ./apps/api run start:prod"

<% if (database === 'postgresql') { %>
  prisma-studio:
    build:
      context: .
      dockerfile: apps/api/Dockerfile
    container_name: <%= projectName %>-prisma-studio
    environment:
      DATABASE_URL: <%= dockerDatabaseUrl %>
    ports:
      - "5555:5555"
    depends_on:
      postgres:
        condition: service_healthy
    command: >
      sh -c "pnpm --filter ./apps/api exec prisma studio --port 5555 --hostname 0.0.0.0 --browser none"

<% } %>
<% if (includeWeb) { %>
  web:
    build:
      context: .
      dockerfile: apps/web/Dockerfile
      args:
        - NEXT_PUBLIC_API_URL=http://localhost:3001
    container_name: <%= projectName %>-web
    environment:
      NEXT_PUBLIC_API_URL: http://localhost:3001
      PORT: 3002
    ports:
      - "3002:3002"
    depends_on:
      - api

<% } %>
<% if (database === 'postgresql') { %>
volumes:
  postgres_data:
<% } %>
